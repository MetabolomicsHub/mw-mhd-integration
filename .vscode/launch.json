{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mw2mhd Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
        {
            "name": "mw2mhd Python Debugger: Create Legacy Batch",
            "type": "debugpy",
            "request": "launch",
            "module": "mw2mhd.commands.cli",
            "args": [
                "create",
                "legacy-batch",
                "--study-list",
                "${workspaceFolder}/missing_datasets.txt",
                "--output-dir",
                "${workspaceFolder}/.outputs/mhd_legacy",
                "--data-path",
                "${workspaceFolder}/.outputs/mw_dataset",
                "--verbose",
                "--log-file", 
                ".outputs/mhd_legacy/conversion-verbose-ii.log"
            ],
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
        {
            "name": "mw2mhd Python Debugger: Analyze Conversion Log",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/analyze_conversion_log.py",
            "args": [
                "${workspaceFolder}/.outputs/mhd_legacy/conversion-verbose.log",
                "--output",
                "${workspaceFolder}/.outputs/log_analysis/conversion-verbose-analysis.json",
                "--top-n",
                "25"
            ],
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        }
    ]
}
